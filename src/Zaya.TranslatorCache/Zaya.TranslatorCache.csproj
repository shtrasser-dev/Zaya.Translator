<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ZayaVersionRole>interface</ZayaVersionRole>
    <ZayaVersionInterface>1</ZayaVersionInterface>

    <PackageId>Zaya.TranslatorCache</PackageId>
    <Description>Translation cache abstractions for the Zaya ecosystem: pluggable session wrappers with settings.</Description>
    <PackageTags>translation;cache;abstractions</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>SHTrassEr</Authors>
    <RepositoryUrl>https://github.com/shtrasser-dev/Zaya.Translator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://shtrasser-dev.github.io/Zaya.Translator</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Zaya.Primitives" Version="$(ZayaPrimitivesVersion)" />
    <ProjectReference Include="..\Zaya.Translator\Zaya.Translator.csproj" />
  </ItemGroup>

</Project>
