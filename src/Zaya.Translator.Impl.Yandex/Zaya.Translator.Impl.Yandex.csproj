<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>13</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ZayaVersionRole>plugin</ZayaVersionRole>
    <ZayaVersionImpMajor>0</ZayaVersionImpMajor>
    <ZayaVersionImpMinor>2</ZayaVersionImpMinor>

    <PackageId>Zaya.Translator.Impl.Yandex</PackageId>
    <Description>Yandex Translate engine for Zaya.Translator (Cloud API v2 and free browser endpoint).</Description>
    <PackageTags>translation;yandex</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>SHTrassEr</Authors>
    <RepositoryUrl>https://github.com/shtrasser-dev/Zaya.Translator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://shtrasser-dev.github.io/Zaya.Translator</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zaya.Translator\Zaya.Translator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Zaya.Logging" Version="$(ZayaLoggingVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Zaya.Translator.Impl.Yandex.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
